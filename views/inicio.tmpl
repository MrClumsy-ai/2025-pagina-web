{{ define "inicio" }}
<!doctype html>
<html lang="es">
  <head>
    <title>Adopta a un amigo</title>
    {{ template "meta" . }}
    {{ template "librerias" . }}
    <link rel="stylesheet" href="{{ .URL }}/assets/inicio.css" />
    <link rel="stylesheet" href="{{ .URL }}/assets/mascotas.css" />
    <script src="{{ .URL }}/assets/mascotas.js"></script>
  </head>
  <body>
    {{ template "navbar" . }}
    <header style="height: 100vh;">
      <div class="row">
        <div class="col-6">
          <h1>ADOPTA A UN AMIGO!</h1>
        </div>
      </div>
    </header>
    <hr />
    <main class="container-fluid">
      <div class="container">
        <h2>Tu proximo amigo!</h2>
        {{ range .Mascotas }}
          {{ template "mascota" . }}
        {{ end }}
      </div>
      <div class="d-grid mx-auto">
        <a class="p-4 rounded-pill mx-auto" href="{{ .URL }}/mascotas"
          >Ver mas</a
        >
      </div>
    </main>
  </body>
</html>
{{ end }}
