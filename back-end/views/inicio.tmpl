{{ define "inicio" }}
<!doctype html>
<html lang="es">
  <head>
    <title>Adopta a un amigo</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- htmx -->
    <script
      src="https://unpkg.com/htmx.org@2.0.4"
      integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
      crossorigin="anonymous"
    ></script>
    <!-- Bootstrap5: CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap5: JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/assets/general.css" />
    <link rel="stylesheet" href="/assets/inicio.css" />
    <link rel="stylesheet" href="/assets/mascotas.css" />
  </head>
  <body>
    {{ template "navbar" . }}

    <header style="height: 100vh">
      <div class="row">
        <div class="col-6">
          <h1>ADOPTA A UN AMIGO!</h1>
        </div>
      </div>
    </header>

    <hr />

    <main class="container-fluid">
      <div class="container">
        <h2>Tu proximo amigo!</h2>
        {{ template "mascota" .}}
      </div>
      <div class="d-grid mx-auto">
        <a class="p-4 rounded-pill mx-auto" href="../mascotas/mascotas.html"
          >Ver mas</a
        >
      </div>
    </main>
  </body>
</html>
{{ end }}
