{{ define "mascotas" }}
<!doctype html>
<html lang="en">

<head>
  <title>Mascotas</title>
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- htmx -->
  <script
    src="https://unpkg.com/htmx.org@2.0.4"
    integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
    crossorigin="anonymous"
  ></script>
  <!-- Bootstrap5: CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <!-- Bootstrap5: JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="assets/mascotas.css" />
  <link rel="stylesheet" href="assets/general.css" />
  <script src="/assets/mascotas.js"></script>
</head>

<body>
  {{ template "navbar" . }}
  <main class="container-fluid" style="margin-top: 80px">
    <div class="container">
      <h2>Tu proximo amigo!</h2>
      {{ template "mascota" .}}
    </div>
  </main>

  <div id="detalleMascota" class="modal-mascota">
    <div class="modal-content">
      <span class="close-btn" onclick="cerrarModal()">&times;</span>
      <img src="img/mascota02.jpg" alt="Foto de la mascota" />
      <h2>Nombre de la mascota</h2>
      <p><strong>Edad:</strong> 3 años</p>
      <p><strong>Altura:</strong> 48cm</p>
      <p>Lorem ipsum dolor sit amet consectetur, adipisicing elit.
        Eveniet, nihil veniam suscipit quidem
      </p>
      <button class="adopt-btn">Solicitar adopción</button>
    </div>
  </div>
</body>

</html>
{{ end }}
