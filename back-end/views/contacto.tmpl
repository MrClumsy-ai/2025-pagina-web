{{ define "contacto" }}
<!doctype html>
<html lang="es">
  <head>
    <title>Contacto</title>
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- htmx -->
    <script
      src="https://unpkg.com/htmx.org@2.0.4"
      integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
      crossorigin="anonymous"
    ></script>
    <!-- Bootstrap5: CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap5: JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/assets/general.css" />
    <link rel="stylesheet" href="/assets/contacto.css" />
  </head>

  <body>
  {{ template "navbar" . }}
    <main class="container-fluid" style="margin-top: 80px">
      <article class="container">
        <h1>¡Hablemos!</h1>
        <p>
          ¿Tienes dudas sobre la adopción? ¿Quieres colaborar o simplemente
          decir hola? 🐾<br />
          Estamos felices de saber de ti. Escríbenos y te responderemos lo más
          pronto posible.
        </p>

        <div class="container mt-5">
          <div class="row">
            <!-- Formulario -->
            <div class="col-md-6 mb-4">
              <form>
                <div class="mb-3">
                  <label for="nombre" class="form-label text-light"
                    >Nombre:</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="nombre"
                    placeholder="Tu nombre"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label for="correo" class="form-label text-light"
                    >Correo electrónico:</label
                  >
                  <input
                    type="email"
                    class="form-control"
                    id="correo"
                    placeholder="correo@ejemplo.com"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label for="mensaje" class="form-label text-light"
                    >Mensaje:</label
                  >
                  <textarea
                    class="form-control"
                    id="mensaje"
                    rows="4"
                    placeholder="¿En qué podemos ayudarte?"
                    required
                  ></textarea>
                </div>

                <button type="submit" class="btn btn-success rounded-pill px-4">
                  Enviar mensaje
                </button>
              </form>
            </div>

            <!-- Redes sociales -->
            <div class="col-md-6 text-light">
              <h4 class="mb-3">Síguenos en nuestras redes 🐾</h4>
              <ul class="list-unstyled">
                <li>
                  <a href="#" class="text-decoration-none text-light"
                    >🐶 Facebook: /AdoptaUnAmigo</a
                  >
                </li>
                <li>
                  <a href="#" class="text-decoration-none text-light"
                    >📸 Instagram: @adopta_amigo</a
                  >
                </li>
                <li>
                  <a href="#" class="text-decoration-none text-light"
                    >🐦 Twitter/X: @AdoptaAmigo</a
                  >
                </li>
                <li>
                  <a href="#" class="text-decoration-none text-light"
                    >📍 TikTok: @amigopeludo</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>
      </article>
    </main>
  </body>
</html>
{{ end }}
