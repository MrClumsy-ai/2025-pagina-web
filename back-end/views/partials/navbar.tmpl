{{ define "navbar" }}
    <nav class="navbar navbar-expand-sm navbar-dark fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="http://localhost:8000/">
          <!-- cambiar para hacer el logo real -->
          <img
            src="assets/logo.webp"
            alt="Logo"
            style="width: 40px"
            class="rounded-pill"
          />
        </a>
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link {{ if eq .CurrentRoute "/" }}active{{ end }}" href="http://localhost:8000/">Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{ if eq .CurrentRoute "/adopcion" }}active{{ end }}" href="http://localhost:8000/adopcion">Adopcion</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{ if eq .CurrentRoute "/mascotas" }}active{{ end }}" href="http://localhost:8000/mascotas">Mascotas</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {{ if eq .CurrentRoute "/contacto" }}active{{ end }}" href="http://localhost:8000/contacto">Contacto</a>
          </li>
        </ul>
      </div>
    </nav>
{{ end }}
