{{ define "mascota" }}
{{ range .Mascotas }}
<article class="container rounded-5 p-5">
  <img src="data:image/jpeg;base64,{{ .Foto64 }}" alt="Foto de la mascota" />
  <div>
    <h3>{{ .Nombre }}</h3>
    <ul>
      <li>Edad: {{ .Edad }} anios</li>
      <li>Altura: {{ .Altura }}cm</li>
    </ul>
    <button class="p-4 rounded-pill" type="button">Ver Detalles</button>
  </div>
</article>
{{ end }}
{{ end }}
